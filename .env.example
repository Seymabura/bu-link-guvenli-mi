# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldur.
# .env.local GitHub'a GÖNDERİLMEZ, anahtarların gizli kalır.

# Sitenin yayındaki adresi (paylaşım görselleri ve sitemap için)
NEXT_PUBLIC_SITE_URL=https://bu-link-guvenli-mi.vercel.app

# İsteğe bağlı: Google Safe Browsing API anahtarı.
# Boş bırakılırsa site sadece kendi kurallarıyla çalışır.
# Anahtar almak için: Google Cloud Console > "Safe Browsing API"yi etkinleştir > Kimlik bilgileri > API anahtarı
GOOGLE_SAFE_BROWSING_API_KEY=
